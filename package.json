{
  "name": "imran-alasr-website",
  "version": "1.0.0",
  "private": true,
  "description": "Corporate website for Imran Alasr Alhaditha Contracting Company",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "db:init": "node --experimental-sqlite scripts/db-init.mjs",
    "admin:create": "node --experimental-sqlite scripts/create-admin.mjs",
    "test": "node --experimental-sqlite --test tests/*.test.mjs"
  },
  "dependencies": {
    "gsap": "3.13.0",
    "lenis": "1.3.11",
    "next": "15.5.21",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "server-only": "^0.0.1",
    "sharp": "0.34.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/postcss": "4.1.14",
    "@types/node": "22.18.6",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "9.36.0",
    "eslint-config-next": "15.5.21",
    "tailwindcss": "4.1.14",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
